<center><h1>Kittens</h1></center>

<% @kittens.each do |kitten| %>
<div>
     <p>Name: <%= kitten.name %></p>
     <p>Age: <%= kitten.age %></p>
     <p>Cuteness = <%= kitten.cuteness %></p>
    <p>Softness = <%= kitten.softness %></p>
    <%= link_to "Edit", edit_kitten_path(kitten) %>
    <%= link_to "Show", kitten_path(kitten) %>
    <%= button_to "Delete", kitten_path(kitten), method: :delete, data: { turbo_confirm: "Are you sure?" } %>
</div>
<% end %>
<%= link_to "NEW", kittens_new_path %>

